run = "npm run dev"
entrypoint = "server/index.ts"
modules = ["nodejs-20"]
hidden = [".config", "node_modules", "dist", "data"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
NODE_ENV = "development"
