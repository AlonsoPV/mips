# PostgreSQL de Replit (obligatorio en Autoscale).
# En local, si se omite, Míps Connect usa PGlite embebido en ./data
DATABASE_URL=

# Puerto de escucha. Replit inyecta PORT. Nunca hardcodear localhost en producción.
PORT=5000

# Secreto de sesión. Genera uno largo y aleatorio en Deployments → Secrets.
SESSION_SECRET=cambia-este-secreto-en-produccion

# Contraseña del usuario demo. Nunca va en el frontend.
DEMO_PASSWORD=MipsDemo2026!

# Permite el botón "Regenerar datos demo" (también se habilita si NODE_ENV !== production).
ALLOW_RESEED=false
