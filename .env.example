# PostgreSQL de Replit (obligatorio en Autoscale).
# En local, si se omite, Míps Connect usa PGlite embebido en ./data
DATABASE_URL=

# Puerto de escucha. Replit inyecta PORT. Nunca hardcodear localhost en producción.
PORT=5000

# Permite regenerar los datos simulados solo cuando es true.
ALLOW_RESEED=false

# En local y en demo, APP_MODE=demo (o se omite) abre el restaurante sin cuentas.
# Producción autenticada: APP_MODE=live.
APP_MODE=demo
# Producción: APP_MODE=live y NODE_ENV=production; origen HTTPS exacto, sin slash final.
PUBLIC_ORIGIN=
# Solo true detrás de un proxy de confianza que controle X-Forwarded-For/Proto.
TRUST_PROXY=false
# JSON de secretos por restaurante/canal. No colocarlos en el frontend ni en Git.
CONNECTOR_KEYS=[]
