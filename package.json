{
  "name": "mips-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:audit": "tsx scripts/audit-check.ts",
    "test:production": "tsx scripts/production-check.ts",
    "user:create": "tsx scripts/provision-user.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
